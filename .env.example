# ==========================================================
# FIRST FEST 2026 - Production Environment Variables
# Copy this file to .env and provide your Supabase Cloud credentials.
# NEVER commit your real .env file with secrets to Git.
# ==========================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon / Public Key (Safe for frontend Supabase Auth client)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-ONLY SECRET. Never expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend Server Configuration
PORT=5000
NODE_ENV=production

# Frontend API base URL (for frontend builds)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
